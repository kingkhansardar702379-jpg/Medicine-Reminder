<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 📱 Features -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 🔔 Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- 🔥 IMPORTANT for background alarm reliability -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedicineReminder"
        tools:targetApi="31">

        <!-- 🔔 Alarm Receiver -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- 🚨 ALARM SCREEN (LOCK SCREEN + FULL SCREEN SUPPORT) -->
        <activity
            android:name=".AlarmScreenActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"/>
        <!-- 📱 MAIN ACTIVITY -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- ➕ ADD MEDICINE -->
        <activity android:name=".AddMedicineActivity"/>

        <!-- 📅 CALENDAR -->
        <activity android:name=".CalendarActivity"/>

    </application>

</manifest>